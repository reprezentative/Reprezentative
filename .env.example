# ============================================================
# Reprezentative — Environment Variables
# Copy to .env.local and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ============================================================

# --- Required ---

# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/reprezentative"

# Signs NextAuth session JWTs. REQUIRED — auth/middleware won't work without it.
NEXTAUTH_SECRET="generate-a-32-byte-base64-secret"

# Encrypts integration API keys stored in the database (AES-256-GCM).
# REQUIRED in production — the app refuses to start with an insecure fallback.
APP_ENCRYPTION_KEY="generate-a-32-byte-base64-secret"

# --- Recommended ---

# Base URL of the app. Defaults to http://localhost:3345 in development.
NEXTAUTH_URL="http://localhost:3345"

# --- AI (optional — can also be set from Admin → Settings → API Keys) ---
DEEPSEEK_API_KEY=""
# Override the DeepSeek base URL (defaults to https://api.deepseek.com/v1).
DEEPSEEK_API_URL=""
# Token pricing used to estimate cost in "API Calls & Usage".
DEEPSEEK_INPUT_PRICE_PER_1M_USD="0.28"
DEEPSEEK_OUTPUT_PRICE_PER_1M_USD="0.42"

# --- Supabase ---
# Public values (safe in the browser) — used by supabase-js if added.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# SECRET — server-only. Enables admin image uploads to Supabase Storage.
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Payments (optional — dashboard-managed keys also supported) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Other integrations (optional) ---
SENDGRID_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
TAXJAR_API_KEY=""
SMARTY_AUTH_ID=""
SMARTY_AUTH_TOKEN=""
